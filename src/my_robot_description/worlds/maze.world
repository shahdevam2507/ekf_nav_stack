      <visual name="vis"><geometry><box><size>4 0.2 1</size></box></geometry>
      <material><ambient>0.4 0.6 0.8 1</ambient></material></visual></link></model>

    <model name="m8"><static>true</static><pose>6 1 0.5 0 0 0</pose>
