<?xml version="1.0"?>
<sdf version="1.6">
  <world name="maze">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Outer boundary -->
    <model name="wall_north"><static>true</static><pose>0 8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16 0.2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>16 0.2 1</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
      </link></model>

    <model name="wall_south"><static>true</static><pose>0 -8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16 0.2 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>16 0.2 1</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
      </link></model>

    <model name="wall_east"><static>true</static><pose>8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 16 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 16 1</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
      </link></model>

    <model name="wall_west"><static>true</static><pose>-8 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 16 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 16 1</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient></material></visual>
      </link></model>

    <!-- Interior maze walls -->
    <model name="m1"><static>true</static><pose>-6 6 0.5 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>4 0.2 1</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>4 0.2 1</size></box></geometry>
      <material><ambient>0.4 0.6 0.8 1</ambient></material></visual></link></model>

    <model name="m2"><static>true</static><pose>2 6 0.5 0 0 0</pose>
      <link name="link"><collision name="col"><geometry><box><size>6 0.2 1</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>6 0.2 1</size></box></geometry>
      <material><ambient>0.4 0.6 0.8 1</ambient></material></visual></link></model>

    <model name="m3"><static>true</static><pose>-4 3 0.5 0 0 1.5708</pose>
      <link name="link"><collision name="col"><geometry><box><size>4 0.2 1</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>4 0.2 1</size></box></geometry>
      <material><ambient>0.4 0.6 0.8 1</ambient></material></visual></link></model>

    <model name="m4"><static>true</static><pose>0 3 0.5 0 0 0</pose>
