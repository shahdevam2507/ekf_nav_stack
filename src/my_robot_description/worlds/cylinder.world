            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>
    <model name="cyl_8">
      <static>true</static>
      <pose>1 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>
    <!-- ── Goal marker at (5, 5) — visual only, no collision ── -->
    <!-- Green cylinder on ground marks the goal location -->
    <model name="goal_marker">
      <static>true</static>
      <pose>5 5 0.02 0 0 0</pose>
      <link name="link">
        <!-- No collision — robot can drive over it -->
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 1.0 0.0 1</ambient>
            <diffuse>0.0 1.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Goal pole — tall thin green pole so visible from far -->
    <model name="goal_pole">
      <static>true</static>
      <pose>5 5 0.75 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 1.0 0.0 1</ambient>
            <diffuse>0.0 1.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
