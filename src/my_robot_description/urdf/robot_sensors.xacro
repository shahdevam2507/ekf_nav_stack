<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="lidar_sensor">

  <joint name="chassis2lidar" type="fixed">
    <parent link="chassis"/>
    <child  link="lidar_link"/>
    <!-- Mounted on top of the newly raised chassis -->
    <origin xyz="0.0 0.0 ${chassis_height + 0.02}" rpy="0.0 0.0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

</xacro:macro>
</robot>
