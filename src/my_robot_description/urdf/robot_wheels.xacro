<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="robot_wheel" params="side y_offset x_offset">

  <joint name="${side}_wheel_joint" type="continuous">
    <origin xyz="${x_offset} ${y_offset} 0.0" rpy="${-pi/2} 0.0 0.0"/>
    <parent link="chassis"/>
    <child  link="${side}_wheel"/>
    <axis xyz="0.0 0.0 1.0"/>
  </joint>

  <link name="${side}_wheel">
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1/12)*wheel_mass*(3*wheel_radius**2 + wheel_width**2)}"
        ixy="0.0" ixz="0.0"
        iyy="${(1/12)*wheel_mass*(3*wheel_radius**2 + wheel_width**2)}"
        iyz="0.0"
        izz="${(1/2)*wheel_mass*wheel_radius**2}"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <!-- cylinder collision — NOT sphere (sphere causes shaking) -->
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <!-- Gazebo physics — Imported from TurtleBot3 Waffle -->
  <gazebo reference="${side}_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

</xacro:macro>
</robot>
